    {
      "name": "Flujo de escritura en base de prueba",
      "description": "Ejecutar en orden con dos usuarios diferentes de la base dummy. Crea y archiva datos de ejemplo.",
      "item": [
        {
          "name": "Iniciar sesión del solicitante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{otroEmail}}\", \"password\": \"{{otroPassword}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set(\"otroToken\", data.token); pm.collectionVariables.set(\"otroUserId\", data.user.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear iniciativa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
