  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Inicio de sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set(\"token\", data.token); pm.collectionVariables.set(\"userId\", data.user.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener iniciativa propia",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/initiatives/mine"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta 200\", function () { pm.response.to.have.status(200); });",
                  "const items = pm.response.json().items; pm.test(\"Existe una iniciativa propia\", function () { pm.expect(items.length).to.be.above(0); }); if (items.length) pm.collectionVariables.set(\"initiativeId\", items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro con datos inválidos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
